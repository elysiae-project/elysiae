<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>@APP_ID@</id>
    <name>Elysiae</name>
    <summary>Unified anime game launcher</summary>
    <developer id="app.elysiae">
        <name>The Elysiae Project</name>
    </developer>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>BSD-3-Clause</project_license>
    <description>
        <p>Elysiae is a unified and performant game launcher for "Anime Games" from a certain Chinese video game company</p>
    </description>
    <launchable type="desktop-id">@APP_ID@.desktop</launchable>
    <categories>
        <category>Utility</category>
        <category>Game</category>
    </categories>
    <requires>
        <kernel version="6.14" compare="ge">Linux</kernel>
        <internet>first-run</internet>
    </requires>
    <recommends>
        <control>keyboard</control>
        <control>pointing</control>
        <display_length compare="ge">1279</display_length>
    </recommends>
    <supports>
        <control>gamepad</control>
        <control>touch</control>
    </supports>
    <url type="homepage">https://elysiae.app</url>
    <url type="bugtracker">https://github.com/elysiae-project/elysiae/issues</url>
    <!--TODO: Add branding colours once they are finalized-->
    <!--TODO: Get app screenshots before release-->
    <releases>
        <!--TODO: fill with initial release information once 1.0 releases-->
    </releases>
    <content_rating type="oars-1.1">
        <content_attribute id="violence-fantasy">moderate</content_attribute>
        <content_attribute id="violence-bloodshed">mild</content_attribute>
        <content_attribute id="drugs-alcohol">moderate</content_attribute>
        <content_attribute id="sex-themes">mild</content_attribute>
        <content_attribute id="language-profanity">mild</content_attribute>
        <content_attribute id="language-humor">mild</content_attribute>
        <content_attribute id="social-chat">moderate</content_attribute>
        <content_attribute id="social-info">moderate</content_attribute>
        <content_attribute id="social-audio">moderate</content_attribute>
        <content_attribute id="money-purchasing">intense</content_attribute>
        <content_attribute id="money-gambling">mild</content_attribute>
  </content_rating>
</component>
