<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="ElysiaeSettings" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">20</property>
    <property name="overflow">hidden</property>
    <property name="accessible-role">dialog</property>
    <accessibility><property name="label">Settings</property><property name="modal">true</property></accessibility>
    <style>
      <class name="settings"/>
      <class name="settings-panel"/>
    </style>
    <child>
      <object class="GtkBox">
        <property name="spacing">16</property>
        <style><class name="settings-header"/></style>
        <child>
          <object class="GtkLabel">
            <property name="label">Settings</property>
            <property name="xalign">0</property>
            <property name="hexpand">true</property>
            <property name="accessible-role">heading</property>
            <style><class name="settings-heading"/></style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="close">
            <property name="tooltip-text">Close settings</property>
            <property name="valign">center</property>
            <property name="width-request">40</property>
            <property name="height-request">40</property>
            <accessibility><property name="label">Close settings</property></accessibility>
            <style><class name="settings-close"/></style>
            <child>
              <object class="GtkImage">
                <property name="icon-name">window-close-symbolic</property>
                <style><class name="settings-close-icon"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="vexpand">true</property>
        <property name="propagate-natural-height">true</property>
        <property name="max-content-height">480</property>
        <style><class name="settings-scroll"/></style>
        <child>
          <object class="GtkViewport">
            <property name="scroll-to-focus">true</property>
            <style><class name="settings-viewport"/></style>
            <child>
              <object class="GtkBox" id="content">
                <property name="orientation">vertical</property>
                <property name="spacing">20</property>
                <style><class name="settings-content"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="error">
        <property name="visible">false</property>
        <property name="wrap">true</property>
        <property name="xalign">0</property>
        <property name="selectable">true</property>
        <property name="accessible-role">alert</property>
        <style><class name="settings-error"/></style>
      </object>
    </child>
    <child>
      <object class="GtkLabel">
        <property name="label">Changes are saved immediately.</property>
        <property name="xalign">0</property>
        <property name="wrap">true</property>
        <style><class name="settings-footer"/></style>
      </object>
    </child>
  </template>
</interface>
