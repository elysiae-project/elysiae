<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="ElysiaeBackground" parent="GtkBox">
    <style><class name="background"/></style>
    <child>
      <object class="GtkOverlay">
        <property name="hexpand">true</property><property name="vexpand">true</property>
        <style><class name="background-layers"/></style>
        <child>
          <object class="GtkBox" id="fallback">
            <property name="orientation">vertical</property>
            <property name="halign">fill</property><property name="valign">fill</property>
            <style><class name="background-fallback"/></style>
            <child>
              <object class="GtkLabel">
                <property name="label">Elysiae</property>
                <property name="hexpand">true</property><property name="vexpand">true</property>
                <property name="can-target">false</property>
                <style><class name="background-wordmark"/></style>
              </object>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkPicture" id="background">
            <property name="content-fit">cover</property><property name="can-shrink">true</property>
            <property name="hexpand">true</property><property name="vexpand">true</property>
            <property name="can-target">false</property>
            <style><class name="background-image"/></style>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkVideo" id="video">
            <property name="autoplay">true</property><property name="loop">true</property>
            <property name="hexpand">true</property><property name="vexpand">true</property>
            <property name="can-target">false</property>
            <property name="opacity">0</property>
            <style><class name="background-video"/></style>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkPicture" id="overlay">
            <property name="content-fit">cover</property><property name="can-shrink">true</property>
            <property name="hexpand">true</property><property name="vexpand">true</property>
            <property name="can-target">false</property>
            <style><class name="background-art-overlay"/></style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
